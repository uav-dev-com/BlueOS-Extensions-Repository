                    "name": "Blue Robotics",
                    "email": "support@bluerobotics.com"
                },
                "permissions": {
                    "NetworkMode": "host",
                    "HostConfig": {
                        "Privileged": true,
                        "Binds": [
                            "/usr/blueos/extensions/jupyter/root:/root:rw",
